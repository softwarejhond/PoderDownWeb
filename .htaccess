# ===== Poder Down — Reescritura de URLs =====
Options -Indexes +FollowSymLinks
RewriteEngine On

# Redirige las peticiones externas con .php a la versión sin extensión (301)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Sirve internamente el archivo .php cuando se pide la URL sin extensión
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
