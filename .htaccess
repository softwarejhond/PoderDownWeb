# ===== Poder Down — Reescritura de URLs =====
Options -Indexes +FollowSymLinks
RewriteEngine On

# ===== SEO: redirecciones 301 (solo producción) =====
# HTTP -> HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:|$) [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www -> no-www (dominio canónico: poderdown.com)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ===== Página 404 personalizada =====
ErrorDocument 404 /404.php

# Redirige las peticiones externas con .php a la versión sin extensión (301)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Sirve internamente el archivo .php cuando se pide la URL sin extensión
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
